# ==============================================================================
# FinTech MLOps Platform — Environment Variables (EXAMPLE)
# ==============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env itself.
# ==============================================================================

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fintech
POSTGRES_USER=fintech_user
POSTGRES_PASSWORD=changeme_postgres

# --- MinIO (S3-compatible storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=mlflow-artifacts

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_BACKEND_STORE_URI=postgresql://fintech_user:changeme_postgres@localhost:5432/mlflow
MLFLOW_ARTIFACT_ROOT=s3://mlflow-artifacts

# --- RabbitMQ (Messaging & Outbox events) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- Mailpit (Development SMTP & Email Catcher) ---
MAILPIT_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Microservice Ports ---
GATEWAY_PORT=8080
AUTH_PORT=8081
CUSTOMER_PORT=8082
TRANSACTION_PORT=8083
RISK_PORT=8084
NOTIFICATION_PORT=8085
AUDIT_PORT=8086
FASTAPI_PORT=8000
FRONTEND_PORT=3000

# --- FastAPI ML Service ---
FASTAPI_MODEL_URI=models:/fraud-detector/Production
FASTAPI_HOST=0.0.0.0
