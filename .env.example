# ==============================================================================
# FinTech MLOps Platform — Environment Variables (EXAMPLE)
# ==============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env itself.
# ==============================================================================

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fintech
POSTGRES_USER=fintech_user
POSTGRES_PASSWORD=changeme_postgres

# --- MinIO (S3-compatible storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=mlflow-artifacts

# --- MLflow Server (Tracking & Registry Infrastructure) ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_BACKEND_STORE_URI=postgresql://fintech_user:changeme_postgres@localhost:5432/mlflow
MLFLOW_ARTIFACT_ROOT=s3://mlflow-artifacts

# --- RabbitMQ (Messaging & Outbox events) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- Mailpit (Development SMTP & Email Catcher) ---
MAILPIT_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Microservice Ports ---
GATEWAY_PORT=8080
AUTH_PORT=8081
CUSTOMER_PORT=8082
TRANSACTION_PORT=8083
RISK_PORT=8084
NOTIFICATION_PORT=8085
AUDIT_PORT=8086
FASTAPI_PORT=8000
FRONTEND_PORT=3000

# --- FastAPI ML Serving Service (Role 5 — ml/serving) ---
# Server Network Binding
FASTAPI_HOST=0.0.0.0
# Backward-compatible model URI (APPLICATION_CONCEPTION Section 24)
FASTAPI_MODEL_URI=models:/fraud-detector/Production

# MLflow 2.x Model Registry Target (used by ml/serving/model_loader.py)
MODEL_NAME=fraud-detector
MODEL_ALIAS=production

# FastAPI S3 / MinIO Client Credentials (needed to download model artifacts from S3)
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=changeme_minio

# Background Model Loader Resilience & Backoff
STARTUP_LOAD_ENABLED=true
LOADER_INITIAL_BACKOFF_SECONDS=2.0
LOADER_MAX_BACKOFF_SECONDS=30.0
LOADER_MAX_ATTEMPTS=0

# Inter-Service Authentication & Observability
INTERNAL_API_KEY=
LOG_LEVEL=INFO

# Dimensionality Reduction Visualizations (PCA / t-SNE / UMAP static artifacts)
VIZ_DATA_DIR=ml/visualization/embeddings
VIZ_MAX_POINTS=2000
